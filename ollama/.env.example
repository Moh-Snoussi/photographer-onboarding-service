# Ollama model used by the scraper and model-management scripts.
OLLAMA_MODEL=qwen3:1.7b

# Keep the API private by default. Use a reverse proxy with authentication if
# the service must be accessed from another host.
OLLAMA_HOST=127.0.0.1:11434

# Keep one model resident; suitable for a small CPU-only server.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=10m
