@ollamaBaseUrl = http://127.0.0.1:11434
@ollamaModel = qwen3:1.7b

### Verify that the local Ollama API is available.
GET {{ollamaBaseUrl}}/
Accept: application/json

### List locally installed models and verify that {{ollamaModel}} is available.
GET {{ollamaBaseUrl}}/api/tags
Accept: application/json

### Generate a JSON response using the same endpoint and response mode as the scraper.
POST {{ollamaBaseUrl}}/api/chat
Content-Type: application/json
Accept: application/json

{
  "model": "{{ollamaModel}}",
  "messages": [
    {
      "role": "system",
      "content": "Respond with only a valid JSON object containing exactly one property: \"status\" with the string value \"ok\"."
    }
  ],
  "format": "json",
  "stream": false,
  "think": false,
  "options": {
    "temperature": 0
  }
}
