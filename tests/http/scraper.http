@scraperBaseUrl = http://localhost:3001
@onboardingApiToken = change-me-to-a-long-random-secret

### Verify that the scraper worker is available.
GET {{scraperBaseUrl}}/health
Accept: application/json
Authorization: Bearer {{onboardingApiToken}}

### Crawl and normalize the result through the configured LLM adapter.
POST {{scraperBaseUrl}}/smart-crawl
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{onboardingApiToken}}

{
	"url": "https://www.simple-web-solutions.de",
	"allow_text_scraping": true,
	"allow_image_scraping": true,
    "user": {
        "jwt": "your-jwt-token-here"
    }
}

### Reject a request without an HTTP(S) URL.
POST {{scraperBaseUrl}}/smart-crawl
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{onboardingApiToken}}

{
	"url": "not-a-url"
}

### Return a gateway error when the page cannot be reached.
POST {{scraperBaseUrl}}/smart-crawl
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{onboardingApiToken}}

{
	"url": "https://invalid.invalid",
	"allow_image_scraping": true
}
